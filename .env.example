VITE_APP_URL=https://nirmanai.com
VITE_COMPANY_NAME=Apostolic Redeem Services Pvt Ltd

# =============================================================================
# STORAGE & UPLOADS
# =============================================================================
VITE_SUPABASE_STORAGE_BUCKET=uploads
VITE_MAX_FILE_SIZE_MB=10

# =============================================================================
# SECURITY & AUTHENTICATION
# =============================================================================
VITE_JWT_SECRET=your_jwt_secret_for_additional_security
VITE_SESSION_TIMEOUT_MINUTES=480

# =============================================================================
# PAYMENT GATEWAY (Optional - For Future Payment Features)
# =============================================================================
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key

# =============================================================================
# EMAIL SERVICE (Optional - For Notifications)
# =============================================================================
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
