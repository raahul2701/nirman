{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "analyze": "vite build --mode analyze",
    "env:check": "node scripts/validate-env.mjs",
    "deploy:validate": "node scripts/deployment-validate.mjs",
    "supabase:types": "supabase gen types typescript --local > src/types/database.ts",
    "supabase:deploy:functions": "supabase functions deploy ai-proxy health",
    "supabase:health": "node scripts/supabase-healthcheck.mjs",
    "supabase:bootstrap:buckets": "node scripts/supabase-bucket-bootstrap.mjs",
    "supabase:verify:rls": "node scripts/supabase-rls-verify.mjs",
    "supabase:verify:storage": "node scripts/supabase-storage-verify.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@supabase/supabase-js": "^2.105.4",
    "@types/leaflet": "^1.9.21",
    "autotable": "^1.0.0",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.75.0",
    "react-hot-toast": "^2.6.0",
    "react-is": "^19.2.6",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.8.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^7.1.5"
  }
}
